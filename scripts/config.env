# =========================================================
# JARVIS — Configuración del servidor
# =========================================================
# Copia esto a backend/.env y edita los valores

# Token de autenticación (¡CAMBIA ESTO! mínimo 12 caracteres)
AUTH_TOKEN=cambia-este-token-urgentemente

# Modelo via OpenRouter (gratis, sin GPU)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT=180
OPENROUTER_NUM_PREDICT=8192

# Base de datos
DB_PATH=data/conversations.db
UPLOAD_DIR=data/uploads

# Límites
MAX_HISTORY=20
TOOL_TIMEOUT=60
