# =========================================================
# JARVIS — Configuración del servidor
# =========================================================
# Copia esto a backend/.env y edita los valores

# Token de autenticación (¡CAMBIA ESTO! mínimo 12 caracteres)
AUTH_TOKEN=cambia-este-token-urgentemente

# Modelo local via Ollama (100% local, sin API externa)
OLLAMA_MODEL=artenisa
OLLAMA_HOST=http://artenisa-ollama:11434
OLLAMA_TIMEOUT=180
OLLAMA_NUM_PREDICT=400

# Base de datos
DB_PATH=data/conversations.db
UPLOAD_DIR=data/uploads

# Límites
MAX_HISTORY=20
TOOL_TIMEOUT=60
