# =========================================================
# JARVIS — Configuración de Telegram
# =========================================================
# Copia esto a backend/.env.telegram y edita los valores

# URL del backend (localhost si mismo servidor)
API_URL=http://localhost:8000

# Mismo token que en .env
AUTH_TOKEN=cambia-este-token-urgentemente

# Token de tu bot de Telegram (de @BotFather)
TELEGRAM_TOKEN=

# Tu ID de usuario de Telegram (de @userinfobot)
ALLOWED_USER_ID=0
