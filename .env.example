# ============================================================
# Artenisa — variables de entorno opcionales (config de hardware)
# Copiá este archivo a `.env` si querés sobrescribir los defaults,
# o editá directamente aquí (depende de cómo desplegués el stack).
# ============================================================

# CPUs (cpuset) reservadas para el contenedor de Ollama.
# Default: los 8 hilos P del i5-12500H (lógicos 0-7).
# Si notás que el escritorio se traba durante la inferencia, bajá a "0-3"
# (rescata núcleos para el resto del sistema) sin tocar docker-compose.yml.
OLLAMA_CPUSET=0-7

# Quota de CPU (fracción de núcleos) para el contenedor de Ollama.
# Con OLLAMA_CPUSET=0-7 y OLLAMA_CPUS=8 usa hasta el 100% de los 4 P-cores
# físicos para inferencia (máximo tok/s). Si el escritorio se traba, bajá a 4.
OLLAMA_CPUS=8

# Threads que usa el runner de llama.cpp dentro del contenedor.
# Debe ser coherente con OLLAMA_CPUSET: 8 para "0-7", 4 para "0-3".
# Repentinamente subirlo por encima del cpuset empeora el rendimiento.
OLLAMA_THREADS=8